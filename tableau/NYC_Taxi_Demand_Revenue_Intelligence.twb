      <aliases enabled='yes' />
      <column caption='Total trips' datatype='integer' name='[Calculation_4731594441232384]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([trip_count])' />
      </column>
      <column caption='KPI Total Revenue' datatype='real' name='[Calculation_4731594441687042]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_revenue])' />
      </column>
      <column caption='KPI Avg Revenue Per Trip' datatype='real' name='[Calculation_4731594441777155]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_revenue]) / SUM([trip_count])' />
      </column>
      <column caption='KPI Avg Trip Distance' datatype='real' name='[Calculation_4731594441875460]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([avg_trip_distance] * [trip_count])&#10;/&#10;SUM([trip_count])' />
      </column>
      <column caption='Rush Hour Label' datatype='string' name='[Calculation_4731594447884293]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [is_rush_hour] THEN&#10;    &quot;Rush Hour&quot;&#10;ELSE&#10;    &quot;Non-Rush Hour&quot;&#10;END' />
      </column>
      <column caption='KPI Weighted Avg Speed' datatype='real' name='[Calculation_4731594448424966]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([avg_speed] * [trip_count])&#10;/&#10;SUM([trip_count])' />
      </column>
      <column caption='KPI Weighted Avg Duration' datatype='real' name='[Calculation_4731594448515079]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([avg_trip_duration] * [trip_count])&#10;/&#10;SUM([trip_count])' />
      </column>
      <column caption='Weekday' datatype='string' name='[Calculation_4731594458267660]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME(&apos;weekday&apos;, [pickup_date])' />
      </column>
      <column caption='Weekday Number' datatype='integer' name='[Calculation_4731594458341389]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEPART(&apos;weekday&apos;, [pickup_date])' />
      </column>
      <column caption='Airport' datatype='string' name='[Calculation_4731594467024910]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [zone] = &quot;JFK Airport&quot; THEN&#10;    &quot;JFK Airport&quot;&#10;ELSEIF [zone] = &quot;LaGuardia Airport&quot; THEN&#10;    &quot;LaGuardia Airport&quot;&#10;ELSE&#10;    &quot;Non-Airport&quot;&#10;END' />
